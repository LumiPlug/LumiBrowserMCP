{
  "manifest_version": 3,
  "name": "Lumi Browser — AI Browser Automation & MCP",
  "version": "0.5.5",
  "description": "Connect AI agents to authorized Chrome tabs through Lumi and MCP. Read pages, click, type and scroll with visible controls.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "webNavigation",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lumi Browser — AI Browser Automation & MCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "118",
  "key": "",
  "short_name": "Lumi Browser",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:43127"
  },
  "host_permissions": ["http://*/*", "https://*/*"]
}
